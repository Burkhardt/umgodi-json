// Declarative Cross-Engine Parity & CR040 Test Suite
// Exercises bidirectional interaction between Python jpit and C# pits.
{
	Name: "CR040 & Cross-Engine Parity Suite",
	Variables: {
		RootName: "{root}/AIA.ParitySuite",
		PitRoot: "{root}/AIA.ParitySuite"
	},
	Construct: [
		"rm -rf {PitRoot}"
	],
	Tests: [
		{
			Name: "1. Python jpit creates sparse entity -> C# pits reads & exports",
			Steps: [
				{
					Command: "echo '{Id: \"Sipho\", Role: \"Musician\", Status: \"Active\", Coach: \"Soccer\"}' | jpit add Jazz --source - -r {PitRoot}",
					ExpectCode: 0,
					ExpectStdoutContains: "1 written, 0 unchanged"
				},
				{
					Command: "pits export Jazz -r {PitRoot} --json -n",
					ExpectCode: 0,
					ExpectStdoutContains: '"Role": "Musician"'
				}
			]
		},
		{
			Name: "2. C# pits deletes property -> Python jpit confirms projection",
			Steps: [
				{
					Command: "pits delete-property Jazz Sipho Coach -r {PitRoot} -n",
					ExpectCode: 0
				},
				{
					Command: "jpit grep '^Sipho$' Jazz -e -p Id -r {PitRoot} --jq '.[0]'",
					ExpectCode: 0,
					ExpectJson: {
						Id: "Sipho",
						Role: "Musician",
						Status: "Active",
						Deleted: false
					}
				}
			]
		},
		{
			Name: "3. CR040 Invariant: jpit rejects manual Modified payload",
			Steps: [
				{
					Command: "echo '{Id: \"Sipho\", Role: \"Composer\", Modified: \"2026-09-26T23:26:42Z\"}' | jpit add Jazz --source - -r {PitRoot}",
					ExpectCode: 1,
					ExpectStderrContains: "Modified"
				}
			]
		},
		{
			Name: "4. CR040 Invariant: jpit rejects manual Deleted payload",
			Steps: [
				{
					Command: "echo '{Id: \"Sipho\", Deleted: true}' | jpit add Jazz --source - -r {PitRoot}",
					ExpectCode: 1,
					ExpectStderrContains: "Deleted"
				}
			]
		},
		{
			Name: "5. Cross-Engine Deletion: pits deletes item -> jpit verifies 404 & history",
			Steps: [
				{
					Command: "pits delete-item Jazz Sipho -r {PitRoot} -n",
					ExpectCode: 0
				},
				{
					Command: "jpit grep '^Sipho$' Jazz -e -p Id -r {PitRoot} --jq '.[0]'",
					ExpectCode: 0,
					ExpectStdoutContains: "null"
				},
				{
					Command: "jpit -r {RootName} history Jazz Sipho",
					ExpectCode: 0,
					ExpectStdoutContains: '"Deleted": true'
				}
			]
		}
	],
	Destruct: [
		"rm -rf {PitRoot}"
	]
}
